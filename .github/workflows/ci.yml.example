# ci.yml.example — opt-in CI for your project. Rename to ci.yml and adapt.
#
# Everything below is commented out on purpose: attest ships no live CI for your code —
# what your project runs is your decision. This example mirrors the kit's own baseline
# (ruff for Python, shellcheck for shell); swap the steps for your language's tools.
#
# This is the one file under .github/ that is yours: install.sh copies it, and the
# template-cleanup workflow leaves it in place (attest ADR-0021).
#
# Two habits worth keeping when you uncomment: pin the tool version (an unpinned `uvx ruff`
# turns your gate red the day upstream changes a rule or a formatting default), and pin
# actions by commit SHA rather than by a mutable tag.
#
# name: ci
# on:
#   push:
#     branches: [main]
#   pull_request:
#
# permissions:
#   contents: read
#
# jobs:
#   lint:
#     runs-on: ubuntu-latest
#     steps:
#       - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
#       - uses: astral-sh/setup-uv@d4b2f3b6ecc6e67c4457f6d3e41ec42d3d0fcb86 # v5
#
#       # Python — drop if your project has none. Pin the version you actually ran.
#       - run: uvx ruff@0.15.21 check .
#       - run: uvx ruff@0.15.21 format --check .
#
#       # Shell — drop if your project has no scripts
#       - run: |
#           shopt -s nullglob globstar
#           files=(**/*.sh)
#           [ ${#files[@]} -eq 0 ] || uvx --from shellcheck-py shellcheck "${files[@]}"
#         shell: bash
#
#       # Your tests go here — the kit does not guess your test runner
#       # - run: <your test command>
