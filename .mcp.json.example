{
  "_comment": "Rename to .mcp.json and adjust for your app. See GUIDE.md PART 6.",
  "mcpServers": {
    "my-app": {
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/bin/python",
      "args": ["-m", "my_app.mcp_server"],
      "_comment": "Do not put real tokens in env here — this file is git-tracked; keep secrets out of the repo.",
      "env": {
        "MY_APP_DATA": "${CLAUDE_PROJECT_DIR:-.}/data.json"
      }
    }
  }
}
